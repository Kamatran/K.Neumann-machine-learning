# Copy to .env and adjust. Never commit .env.

# --- W1: MLflow as a local service (scripts/mlflow_local.sh), no containers ---

# Where your scripts log runs.
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- From W2: the same MLflow in a container, with PostgreSQL and MinIO ---

# Your user and group id (`id -u`, `id -g`); containers write state/ as this user.
LOCAL_UID=1000
LOCAL_GID=1000

# Local MinIO credentials (at least 8 characters). Used only on this machine.
MINIO_ROOT_USER=mlflow
MINIO_ROOT_PASSWORD=change-me-local-only

# Local PostgreSQL password for the MLflow database. Used only on this machine.
POSTGRES_PASSWORD=change-me-local-only

# Send artifact transfers through the MLflow server. Without these, downloads from MinIO hang
# (details in src/mlproject/tracking.py). Scripts importing mlproject.tracking set them anyway;
# these lines cover notebooks and other tools.
MLFLOW_ENABLE_PROXY_MULTIPART_DOWNLOAD=false
MLFLOW_ENABLE_PROXY_MULTIPART_UPLOAD=false

# Shared server variant, only if announced by the lecturer:
# MLFLOW_TRACKING_URI=https://...
# MLFLOW_TRACKING_USERNAME=
# MLFLOW_TRACKING_PASSWORD=
